# LUMINA — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Both services read this file from the repo root.

# ---------- MongoDB Atlas (documents, memory, cache, jobs, vectors, GridFS) ----------
# Atlas free tier (M0) is enough for two weeks. A local mongod has no Vector Search:
# see VECTOR_BACKEND below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# atlas-vector-search (default) | mongo-cosine-scan (local mongod fallback, /health must say so)
VECTOR_BACKEND=atlas-vector-search

# ---------- LLM ----------
LLM_PROVIDER=anthropic
# Writes answers, and deep search's synthesis. /health reports this one.
LLM_MODEL=claude-sonnet-5
# The quick gear's synthesis. Defaults to LLM_MODEL; a faster model buys time-to-first-token.
LLM_MODEL_QUICK=claude-sonnet-5
# plan_research and the save_memory decision. Haiku keeps the deep plan inside
# deep_plan_p95_ms (4 s); Sonnet with JSON structured output measured 6-9 s.
LLM_MODEL_PLANNER=claude-haiku-4-5
ANTHROPIC_API_KEY=

# ---------- Search (swappable with no code change) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600
# Tavily search depth: fast (default, returns page text in ~0.6 s) | basic (~1.5 s) | ultra-fast
# (~0.2 s but usually no page text, so fetch_page has to call extract separately).
TAVILY_SEARCH_DEPTH=fast
# Per-page read timeout for fetch_page.
FETCH_TIMEOUT_MS=8000

# ---------- OpenAI (embeddings; needed even when the LLM is Anthropic) ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Deep search: the expensive gear, so the gates live here ----------
# Sub-questions a plan may hold. Fewer than 3 is a quick search with extra steps.
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
# Deep searches per X-User-Id per day. Over cap -> 429 {error, resetsAt}, enforced in the
# agent service. A cap you document but do not enforce is not a cap.
DEEP_DAILY_CAP=5
# Pages read per sub-question, and how many sub-questions are researched at once. Both are
# bounded by the deep tool-call cap below, which is divided across the plan.
DEEP_PAGES_PER_SUB_QUESTION=3
DEEP_CONCURRENCY=3

# ---------- Retrieval (top-k and thresholds are config, not hard-coded) ----------
# Pages the quick gear reads after one search.
QUICK_PAGES_TO_FETCH=3
# Hybrid retrieval: candidates per leg, fused results kept, and the RRF constant.
RAG_CANDIDATES=20
RAG_TOP_K=5
RAG_RRF_K=60
# mode=auto trusts a Space over the web only when its best chunk scores at least this
# (cosine). Below it, the router searches the web instead and says so in the trace.
RAG_AUTO_MIN_SCORE=0.35
# recall_memory injects at most this many memories (and ~1000 tokens), ranked by similarity.
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0

# ---------- Loop caps (the hard caps from AGENTS.md; do not raise to pass a gate) ----------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
# Deep gets a wider envelope because it is doing more, not because it is allowed to sprawl.
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ---------- Jobs worker & run logs ----------
# true: the agent service forks and supervises the worker. false: run it yourself with
# `npm run worker` (one worker per deployment is enough; claims are atomic either way).
WORKER_IN_PROCESS=true
# Mirror each run log into the `runs` collection as well as runs/<requestId>.json, so a
# deployed instance can `npm run export:runs` for the trajectory gate.
RUNS_TO_MONGO=true

# At boot, ping Atlas and make one tiny call to each provider so the first real answer does
# not pay the DNS + TLS handshakes inside its time-to-first-token budget. Costs a fraction of
# a cent per start. Set false to see the cold numbers.
WARMUP=true

# ---------- Ports & wiring ----------
PORT_GATEWAY=8787
PORT_AGENT=8000
AGENT_URL=http://localhost:8000
# Comma-separated origins the gateway accepts. Add your Vercel URL before you deploy.
CORS_ORIGINS=http://localhost:5173
# Per-user token bucket at the gateway: writes get this many per minute, reads 10x it.
# The bench drives ~40 asks at concurrency 4, so keep it at 60 or above when benchmarking.
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info

# ---------- Web (Vite; only VITE_* reaches the browser — never put a key here) ----------
VITE_API_URL=http://localhost:8787
